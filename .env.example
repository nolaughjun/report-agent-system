# .env.example - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ══════════════════════════════════════════════════════════════
# 数据库配置
# ══════════════════════════════════════════════════════════════

# PostgreSQL 连接 URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/report_db

# ══════════════════════════════════════════════════════════════
# Redis 配置（并发支持）
# ══════════════════════════════════════════════════════════════

# Redis 连接 URL（启用后支持并发、状态存储、缓存）
REDIS_URL=redis://localhost:6379/0

# Celery 配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ══════════════════════════════════════════════════════════════
# 缓存配置
# ══════════════════════════════════════════════════════════════

# 搜索结果缓存 TTL（秒）
SEARCH_CACHE_TTL=3600

# LLM 响应缓存 TTL（秒）
LLM_CACHE_TTL=7200

# ══════════════════════════════════════════════════════════════
# LLM 模型配置
# ══════════════════════════════════════════════════════════════

# DeepSeek API（推荐）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# OpenAI API（可选）
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic API（可选）
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# 默认模型
DEFAULT_LLM_MODEL=deepseek-chat

# ══════════════════════════════════════════════════════════════
# 数据源配置
# ══════════════════════════════════════════════════════════════

# Tavily 搜索 API（推荐）
TAVILY_API_KEY=tvly-your-tavily-api-key

# Serper 搜索 API（可选）
SERPER_API_KEY=your-serper-api-key

# Brave 搜索 API（可选）
BRAVE_API_KEY=your-brave-api-key

# 自定义搜索 API
CUSTOM_SEARCH_API_KEY=your-custom-api-key
CUSTOM_SEARCH_URL=https://your-search-api.com/search

# 默认数据源
DEFAULT_DATA_SOURCE=tavily

# ══════════════════════════════════════════════════════════════
# 应用配置
# ══════════════════════════════════════════════════════════════

# 调试模式（生产环境设为 false）
DEBUG=false

# 日志级别
LOG_LEVEL=INFO

# 服务端口
PORT=8000

# API 认证密钥（可选，用于 API 访问控制）
API_KEY=your-secure-api-key

# 允许的 CORS 来源
ALLOWED_ORIGINS=*

# ══════════════════════════════════════════════════════════════
# 安全配置
# ══════════════════════════════════════════════════════════════

# JWT 密钥（用于用户认证）
JWT_SECRET=your-jwt-secret-key-change-in-production

# 加密密钥
ENCRYPTION_KEY=your-encryption-key

# ══════════════════════════════════════════════════════════════
# 自定义模型配置
# ══════════════════════════════════════════════════════════════

# 自定义模型 ID
CUSTOM_MODEL_ID=your-custom-model

# 自定义 API Base URL
CUSTOM_API_BASE=https://your-api-endpoint.com/v1

# 自定义 API Key
CUSTOM_API_KEY=your-custom-api-key

# ══════════════════════════════════════════════════════════════
# LangSmith 监控配置
# ══════════════════════════════════════════════════════════════

# 启用 LangSmith 追踪
LANGCHAIN_TRACING_V2=true

# LangSmith API Key（从 https://smith.langchain.com 获取）
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key

# LangSmith 项目名称
LANGCHAIN_PROJECT=report-agent

# LangSmith API 端点（默认）
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
